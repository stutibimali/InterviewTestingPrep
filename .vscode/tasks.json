{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FastAPI: run",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "uvicorn", "app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8001"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Tests: pytest",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "pytest"],
      "problemMatcher": "$python"
    }
  ]
}
